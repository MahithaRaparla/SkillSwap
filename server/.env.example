# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection string: mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillbridge
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge

# JWT Authentication Secret
JWT_SECRET=skillbridge_jwt_secret_key_2026_super_secure

# Allowed Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
